{
  "name": "bandly",
  "version": "0.10.5",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --exclude \"tests/live/**\" --exclude \"tests/db/**\"",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "engine:lab": "tsx scripts/engine-lab.ts",
    "voice:lines": "tsx scripts/voice-lines.ts",
    "voice:render": "pnpm voice:lines && node scripts/run-python.mjs tools/voice/render.py",
    "voice:setup": "node scripts/run-python.mjs tools/voice/download_models.py",
    "test:e2e": "playwright test",
    "test:live": "vitest run tests/live",
    "test:db": "vitest run tests/db --no-file-parallelism",
    "live:check": "node scripts/live-check.mjs",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose stop db",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/db-seed.ts",
    "db:import-json": "tsx scripts/db-import-json.ts",
    "db:studio": "drizzle-kit studio",
    "db:setup": "pnpm db:up && pnpm db:migrate && pnpm db:seed",
    "db:claim-guest": "tsx scripts/db-claim-guest.ts",
    "bootstrap:admins": "tsx scripts/bootstrap-admins.ts",
    "db:content-v2": "tsx scripts/db-content-v2.ts",
    "db:backup": "node scripts/db-backup.mjs"
  },
  "dependencies": {
    "@clerk/backend": "3.23.1",
    "@clerk/nextjs": "^7.9.13",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@clerk/testing": "^2.2.44",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=22"
  }
}
