# ─────────────────────────────────────────────────────────────────────────────
# Bandly environment variables
# Copy this file to `.env.local` and fill in the values. Never commit `.env.local`.
# ─────────────────────────────────────────────────────────────────────────────

# Groq API key (server-only). Create one at https://console.groq.com/keys
# Used for speech-to-text (Whisper) and scoring (LLM). Also used by the
# optional backup voice renderer (tools/voice/render.py --engine groq).
GROQ_API_KEY=gsk_your_key_here

# Speech-to-text models (primary → fallback).
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_STT_FALLBACK_MODEL=whisper-large-v3

# Scoring LLM fallback chain, strongest first. Each Groq model has its own
# free-tier quota, so falling back also spreads usage across quotas.
# (llama-3.3-70b-versatile is not available on every account; check /models.)
GROQ_LLM_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-120b,openai/gpt-oss-20b

# Fast chain for live listening: classifies what the candidate said after every answer.
GROQ_FAST_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-20b

# Per-request timeout for Groq calls (ms).
GROQ_TIMEOUT_MS=30000

# ── Database (PostgreSQL + Drizzle) ─────────────────────────────
# Local: the Docker container from docker-compose.yml (`pnpm db:up`); the values
# below work as-is against that container only.
# Production / Neon (https://neon.tech): DATABASE_URL = the *pooled* connection
# string (host contains "-pooler"), DATABASE_URL_UNPOOLED = the direct string
# (used for migrations). Both end with ?sslmode=require.
DATABASE_URL=postgresql://bandly:bandly@localhost:5433/bandly
DATABASE_URL_UNPOOLED=postgresql://bandly:bandly@localhost:5433/bandly
# Separate database for `pnpm test:db` (created automatically by the container).
DATABASE_URL_TEST=postgresql://bandly:bandly@localhost:5433/bandly_test

# Optional: legacy JSON store, read only by `pnpm db:import-json`.
DATA_DIR=data

# ── Authentication (Clerk) ──────────────────────────────────────
# Create an application at https://dashboard.clerk.com → API keys (use the Development instance).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
# Only needed for webhooks (Clerk dashboard → Webhooks → endpoint /api/webhooks/clerk,
# events user.created, user.updated, user.deleted). Users are also synced on first sign-in.
CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxx

# ── Bootstrap (used only by `pnpm bootstrap:admins`) ────────────
BOOTSTRAP_SUPERADMIN_EMAIL=superadmin@example.com
BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# ── Browser tests (Playwright) ──────────────────────────────────
# A Clerk test address ("+clerk_test" never sends email; verification code 424242).
E2E_CLERK_USER_EMAIL=bandly-e2e+clerk_test@example.com
